# Server only. Never prefix API keys with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Optional private deployment access token; required to enable AI when NODE_ENV=production.
# Leave blank to browse/adopt without AI credentials.
# The visitor enters it in settings. Use at least 32 random characters.
APP_ACCESS_TOKEN=
# Optional licensed animated model, served from public/.
NEXT_PUBLIC_PET_MODEL_URL=
# Reserved for Phase 5; cloud sync/auth are not implemented in this version.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
